# whisper_dictate - Environment Configuration
# =============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
#   cp .env.example .env

# ------------------------------------------------------------------
# Required
# ------------------------------------------------------------------

# Your OpenAI API key. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_actual_openai_api_key_here

# ------------------------------------------------------------------
# Transcription (optional)
# ------------------------------------------------------------------

# Backend to use for transcription. Currently only 'openai' is supported.
# Future backends (e.g. 'faster-whisper', 'whisper-cpp') will be added here.
TRANSCRIPTION_BACKEND=openai

# Whisper model to use. 'whisper-1' is the only OpenAI API option.
WHISPER_MODEL=whisper-1

# Default language for transcription.
# Use ISO 639-1 codes: 'en', 'es', 'fr', 'de', 'pt', etc.
# Set to 'auto' to let Whisper detect the language automatically.
DEFAULT_LANGUAGE=auto

# Set to 'true' to always translate audio to English.
ENABLE_TRANSLATION=false

# ------------------------------------------------------------------
# Keys (optional)
# ------------------------------------------------------------------

# Pynput key name that starts and stops recording.
# Any pynput key name works: f1-f20, home, end, insert, delete, page_up,
# page_down, pause, scroll_lock, or a single character such as 'q'.
HOTKEY=f9

# Pynput key name that quits the application. Deliberately not 'esc':
# ESC is pressed far too often to be a safe kill switch. Both keys are
# captured globally, so pick one you will not hit by accident.
QUIT_KEY=home

# ------------------------------------------------------------------
# UI / Alerts (optional)
# ------------------------------------------------------------------

# Volume for audio alerts (0.0 = silent, 1.0 = full volume).
ALERT_VOLUME=0.8

# Set to 'false' to disable all audio alerts.
ALERTS_ENABLED=true

# ------------------------------------------------------------------
# Long recordings (optional)
# ------------------------------------------------------------------

# Recordings auto-stop (and are transcribed) after this many minutes.
MAX_RECORDING_MINUTES=60

# Recordings longer than this are split into segments of at most this many
# seconds, transcribed in parallel and joined back in order. Whisper accepts
# at most 25 MB (~13 min at 16 kHz) per request.
TRANSCRIPTION_CHUNK_SECONDS=300

# Most segments transcribed at the same time.
TRANSCRIPTION_MAX_PARALLEL=4
